# Copy to .env. The defaults match docker-compose.yml as shipped.
#
# IRIS_PORT is 1973, not the IRIS default of 1972, because compose remaps it --
# see the comment in docker-compose.yml.
IRIS_HOST=localhost
IRIS_PORT=1973
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
IRIS_PASSWORD=SYS

# Paths as IRIS sees them, inside the container. These are what server-side
# LOAD DATA reads; the host paths under ./data are irrelevant to IRIS.
TRIPS_CSV_CONTAINER_PATH=/data/2023_Green_Taxi_Trip_Data.csv
ZONES_CSV_CONTAINER_PATH=/data/taxi_zone_lookup(in).csv
