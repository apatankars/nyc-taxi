    ; Run at image build time by the Dockerfile, via: iris session IRIS < iris.script
    ; NOTE: lines must be indented. In ObjectScript an unindented line is a label,
    ; not a command, so removing this leading whitespace breaks the script.

    zn "%SYS"

    ; Stop IRIS forcing a password change on first login. Development convenience
    ; only — never do this on anything reachable from outside your machine.
    do ##class(Security.Users).UnExpireUserPasswords("*")

    ; Enable %Service_CallIn. Required by Embedded Python (irispython) and by the
    ; Native API. Without it, iris.createIRIS() and irispython fail to connect.
    do ##class(Security.Services).Get("%Service_CallIn",.prop)
    set prop("Enabled")=1
    set prop("AutheEnabled")=48
    do ##class(Security.Services).Modify("%Service_CallIn",.prop)

    ; Enable IRIS BI (DeepSee) on the /csp/user web application. The BI User Portal
    ; and Analyzer are served from it, and without this flag they return HTTP 403
    ; rather than any message explaining what is switched off.
    ;   Portal: http://localhost:52773/csp/user/_DeepSee.UserPortal.Home.zen
    do ##class(Security.Applications).Get("/csp/user",.webapp)
    set webapp("DeepSeeEnabled")=1
    do ##class(Security.Applications).Modify("/csp/user",.webapp)

    ; Give the project its own SQL schema. Schemas in IRIS are implicit — they
    ; spring into existence with the first table — so there is nothing to create
    ; here. Tables are created from Python in src/, keeping schema-as-code.

    zn "USER"
    halt
