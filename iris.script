// Dev-only bootstrap, applied at image build time.
// Two jobs, both described in the Dockerfile: clear the expired-password flag
// that blocks the first driver login, and enable the call-in service that the
// Native API and Embedded Python rely on.

zn "%SYS"

// Stock images ship _SYSTEM with the password flagged expired, which turns the
// first DB-API connect into an auth failure instead of a session.
do ##class(Security.Users).UnExpireUserPasswords("*")

// %Service_CallIn is what lets irispython attach to the IRIS process.
set props("Enabled") = 1
do ##class(Security.Services).Modify("%Service_CallIn", .props)

halt
